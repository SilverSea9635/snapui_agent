# ── DeepSeek 基础模型（密钥已在项目根目录 .env 中声明，此处仅为说明）──
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ── Qwen 嵌入模型（1024 维）──
QWEN_EMBED_API_KEY=sk-xxx
QWEN_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=qwen3.7-text-embedding
EMBED_DIM=1024

# ── PostgreSQL（Docker 容器 `postgre`，默认端口 5432）──
POSTGRES_DSN=postgresql://postgres:admin@localhost:5432/langchain_db

# ── Milvus 向量库 ──
# 自托管：本地 Docker 容器 `milvus-standalone`（http://localhost:19530），无需认证
# 托管（Zilliz Cloud，适合小内存服务器）：MILVUS_URI 填集群端点、MILVUS_DB 用 default
#   认证二选一：① 用户名/密码（MILVUS_USER=db_xxx + MILVUS_PASSWORD）② API Key（MILVUS_TOKEN）
MILVUS_URI=https://in03-b15abbec17725da.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_TOKEN=xxx
MILVUS_DB=snapui_rag
MILVUS_COLLECTION=design_knowledge

# ── RAG 参数 ──
RAG_TOP_K=4

# ── 服务监听 ──
AGENT_HOST=127.0.0.1
AGENT_PORT=8000

# ── 可选：图像理解模型（未配置时，图片由上游后端 OCR 后以文本传入）──
# VISION_MODEL=
# VISION_API_KEY=
# VISION_BASE_URL=
